    <string name="assistant_msg_driver_alerts">Recibe avisos inmediatos ante incidentes viales, retrasos o comunicaciones del colegio.</string>
    <string name="assistant_title_driver_profile">Mi Perfil y Cuenta</string>
    <string name="assistant_msg_driver_profile">Consulta tus credenciales de conductor, accede a la guía de ayuda y gestiona el cierre seguro de tu sesión.</string>

    <string name="assistant_title_parent_welcome">¡Bienvenido, Padre de Familia!</string>
