    <string name="assistant_msg_admin_profile">Aquí puedes consultar tus datos de usuario, volver a iniciar esta guía cuando desees y cerrar tu sesión de forma segura.</string>

    <string name="assistant_title_driver_welcome">¡Hola, Conductor!</string>
    <string name="assistant_msg_driver_welcome">Te ayudaré a conocer tu herramienta de trabajo diario para viajes seguros.</string>
    <string name="assistant_title_driver_trip">Tu Viaje en Curso</string>
    <string name="assistant_msg_driver_trip">Inicia tu recorrido, consulta la lista de estudiantes por recoger y confirma su abordaje con un solo toque.</string>
